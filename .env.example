# --- GROQ API KEY ---
# The API key required to access the Groq LLM (e.g. gsk_...)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_CHAT_MODEL="openai/gpt-oss-120b"

# Optional fallback provider
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# --- GITHUB APP CREDENTIALS ---
# Generate these from your GitHub Developer Settings
GITHUB_APP_ID="your_app_id_here"
GITHUB_INSTALLATION_ID="your_installation_id_here"
GITHUB_WEBHOOK_SECRET="your_webhook_secret_here"

# Replace this string with the actual contents of the downloaded .pem file.
# Replace actual newlines with \n so the key stays on a single line!
GITHUB_PRIVATE_KEY="paste_pem_contents_here_with_escaped_newlines"

# --- AUTOMATIC PORTFOLIO SYNC ---
PORTFOLIO_REPOSITORY="Rawdyrathaur/portfolio"
PORTFOLIO_BRANCH="main"
RAG_REFRESH_SECONDS="3600"
RAG_RELOAD_SECRET="choose_a_long_random_secret"

# --- PRODUCTION GUARDRAILS ---
# Use a shared Redis instance in production so limits survive restarts/replicas.
REDIS_URL="redis://localhost:6379/0"
TRUSTED_CLIENT_IP_HEADER="x-forwarded-for"
RATE_LIMIT_CHAT="30"
RATE_LIMIT_WHISPER="8"
RATE_LIMIT_SPEAK="20"
DAILY_AI_REQUEST_LIMIT="500"
MAX_AUDIO_BYTES="5242880"
MAX_AUDIO_DURATION_SECONDS="60"
LLM_TIMEOUT_SECONDS="25"
LLM_MAX_RETRIES="1"
MAX_PROMPT_TOKENS="9000"
RAG_MAX_DISTANCE="0.68"

# Rotate production secrets at least every 90 days. Never reuse them in dev/staging.
